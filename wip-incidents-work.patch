+import { useState, useCallback } from 'react'
+
+export default function useLongAction() {
+  const [running, setRunning] = useState(false)
+  const wrap = useCallback(async (fn) => {
+    if (running) return
+    setRunning(true)
+    try { return await fn() } finally { setRunning(false) }
+  }, [running])
+  return { running, wrap }
+}
