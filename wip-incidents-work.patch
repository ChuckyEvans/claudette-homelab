+import { Router } from 'express'
+import { getDb, audit } from '../db.js'
+import { checkConnectivity, getInternetStatus } from './services.js'
+
+const router = Router()
+
+router.get('/hosts', (req, res) => {
+  try {
+    const db = getDb()
+    const rows = db.all('SELECT * FROM connectivity_hosts ORDER BY id')
+    res.json(rows)
+  } catch (e) { res.status(500).json({ error: e.message }) }
+})
+
+router.post('/hosts', (req, res) => {
+  try {
+    const host = String(req.body.host || '').trim()
+    const note = String(req.body.note || '').slice(0, 256)
+    if (!host) return res.status(400).json({ error: 'host required' })
+    const db = getDb()
+    const now = Date.now()
+    const info = db.run('INSERT INTO connectivity_hosts (host, note, created_at) VALUES (?, ?, ?)', [host, note, now])
+    audit('connectivity.host.add', { host, id: info.lastID }, 'user', req.ip)
+    res.json({ id: info.lastID, host, note })
+  } catch (e) { res.status(500).json({ error: e.message }) }
+})
+
+router.delete('/hosts/:id', (req, res) => {
+  try {
+    const id = parseInt(req.params.id, 10)
+    if (!Number.isFinite(id)) return res.status(400).json({ error: 'invalid id' })
+    const db = getDb()
+    db.run('DELETE FROM connectivity_hosts WHERE id = ?', [id])
+    audit('connectivity.host.delete', { id }, 'user', req.ip)
+    res.json({ ok: true })
+  } catch (e) { res.status(500).json({ error: e.message }) }
+})
+
+router.get('/status', async (req, res) => {
+  try {
+    // current in-memory status from services.js
+    const status = getInternetStatus()
+    res.json({ status, ts: Date.now() })
+  } catch (e) { res.status(500).json({ error: e.message }) }
+})
+
+router.post('/run', (req, res) => {
+  const bcast = req.app.locals.broadcast
+  setImmediate(() => checkConnectivity(bcast).catch(e => console.error('[connectivity] run:', e.message)))
+  res.json({ started: true })
+})
+
+// GET /api/connectivity/history?from=&to=&limit=&host=
+router.get('/history', (req, res) => {
+  try {
+    const db = getDb()
+    const to = req.query.to ? parseInt(req.query.to) : Date.now()
+    const from = req.query.from ? parseInt(req.query.from) : to - (7 * 24 * 60 * 60 * 1000)
+    const limit = Math.min(parseInt(req.query.limit) || 500, 2000)
+    const host = req.query.host ? String(req.query.host) : null
+    const rows = host
+      ? db.all(`SELECT id, host_id, host, ok, latency, method, ts FROM connectivity_checks WHERE ts >= ? AND ts <= ? AND host = ? ORDER BY ts DESC LIMIT ?`, [from, to, host, limit])
+      : db.all(`SELECT id, host_id, host, ok, latency, method, ts FROM connectivity_checks WHERE ts >= ? AND ts <= ? ORDER BY ts DESC LIMIT ?`, [from, to, limit])
+    res.json({ rows, total: rows.length, from, to })
+  } catch (e) { res.status(500).json({ error: e.message }) }
+})
+
+// POST /api/connectivity/backfill — import past internet.check audit_log entries into connectivity_checks
+router.post('/backfill', (req, res) => {
+  try {
+    const db = getDb()
+    const to = req.body.to ? parseInt(req.body.to) : Date.now()
+    const from = req.body.from ? parseInt(req.body.from) : to - (30 * 24 * 60 * 60 * 1000)
+
+    const rows = db.all(`SELECT ts, payload FROM audit_log WHERE event = 'internet.check' AND ts >= ? AND ts <= ? ORDER BY ts ASC`, [from, to])
+    let inserted = 0
+    for (const r of rows) {
+      try {
+        const p = JSON.parse(r.payload)
+        const now = r.ts
+        const hosts = p.results ?? []
+        for (const h of hosts) {
+          const host = h.host ?? null
+          let hostId = null
+          if (host) {
+            const existing = db.get('SELECT id FROM connectivity_hosts WHERE host = ?', [host])
+            if (existing) hostId = existing.id
+            else {
+              const info = db.run('INSERT INTO connectivity_hosts (host, note, created_at) VALUES (?, ?, ?)', [host, null, Date.now()])
+              hostId = info.lastID
+            }
+          }
+          db.run('INSERT INTO connectivity_checks (host_id, host, ok, latency, method, ts) VALUES (?, ?, ?, ?, ?, ?)', [hostId, host, h.ok ? 1 : 0, h.ms ?? null, h.method ?? 'ping', now])
+          inserted++
