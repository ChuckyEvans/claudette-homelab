--- /dev/null
+++ b/src/components/SlowSpinner.jsx
@@ -0,0 +1,37 @@
+import { useState, useEffect } from 'react'
+import { Loader2 } from 'lucide-react'
+
+/**
+ * Non-obtrusive floating spinner that appears when any API request takes
+ * longer than the slow-request threshold (configured in api.js).
+ * pointer-events-none — never blocks clicks or interaction.
+ */
+export default function SlowSpinner({ active }) {
+  const [visible, setVisible] = useState(false)
+  const [fading, setFading]   = useState(false)
+
+  useEffect(() => {
+    if (active) {
+      setFading(false)
+      setVisible(true)
+    } else if (visible) {
+      setFading(true)
+      const t = setTimeout(() => { setVisible(false); setFading(false) }, 400)
+      return () => clearTimeout(t)
+    }
+  }, [active]) // eslint-disable-line react-hooks/exhaustive-deps
+
+  if (!visible) return null
+
+  return (
+    <div
+      className="fixed inset-0 z-[150] pointer-events-none flex items-center justify-center"
+      style={{ opacity: fading ? 0 : 1, transition: 'opacity 400ms ease' }}
+    >
+      <div className="flex items-center gap-2.5 px-4 py-2.5 bg-[#0c0c1e]/90 backdrop-blur-md border border-indigo-500/20 rounded-full shadow-2xl">
+        <Loader2 className="w-3.5 h-3.5 text-indigo-400 animate-spin flex-shrink-0" />
+        <span className="text-xs text-slate-400 select-none">Loading…</span>
+      </div>
+    </div>
+  )
+}
diff --git a/src/components/TimedProgressBar.jsx b/src/components/TimedProgressBar.jsx
new file mode 100644
index 0000000..74819dd
--- /dev/null
+++ b/src/components/TimedProgressBar.jsx
@@ -0,0 +1,77 @@
+import { useState, useEffect, useRef } from 'react'
+
+/**
+ * Slim animated progress bar for long-running operations with a known
+ * approximate duration. Advances to ~92% over `durationMs`, holds there
+ * until `active` goes false, then fills to 100% and fades out.
+ *
+ * Props:
+ *   active      – bool   – whether the operation is running
+ *   durationMs  – number – estimated duration in milliseconds (default 40s)
+ *   color       – 'indigo' | 'violet' | 'sky' (default 'indigo')
+ */
+export default function TimedProgressBar({ active, durationMs = 40000, color = 'indigo' }) {
+  const [visible, setVisible] = useState(false)
+  const [fading,  setFading]  = useState(false)
+  const [pct,     setPct]     = useState(0)
+  const rafRef   = useRef(null)
+  const startRef = useRef(null)
+
+  useEffect(() => {
+    if (active) {
+      cancelAnimationFrame(rafRef.current)
+      setFading(false)
+      setVisible(true)
+      setPct(0)
+      startRef.current = performance.now()
+
+      const tick = () => {
+        const elapsed = performance.now() - startRef.current
+        // sqrt easing: fast initial progress that slows as it approaches the cap
+        const raw   = Math.min(elapsed / durationMs, 1.5) // allow up to 1.5× duration
+        const eased = Math.min(Math.sqrt(raw / 1.5) * 92, 92)
+        setPct(eased)
+        rafRef.current = requestAnimationFrame(tick)
+      }
+
+      rafRef.current = requestAnimationFrame(tick)
+      return () => cancelAnimationFrame(rafRef.current)
+    } else if (visible) {
+      cancelAnimationFrame(rafRef.current)
+      setPct(100)
+      setFading(true)
+      const t = setTimeout(() => { setVisible(false); setFading(false); setPct(0) }, 700)
+      return () => clearTimeout(t)
+    }
+  }, [active]) // eslint-disable-line react-hooks/exhaustive-deps
+
+  if (!visible) return null
+
+  const glowColor = color === 'violet'
+    ? 'rgba(139,92,246,0.6)'
+    : color === 'sky'
+    ? 'rgba(56,189,248,0.6)'
+    : 'rgba(99,102,241,0.6)'
+
+  const barColor = color === 'violet'
+    ? 'bg-violet-500'
+    : color === 'sky'
+    ? 'bg-sky-400'
+    : 'bg-indigo-500'
+
+  return (
+    <div
+      className="relative h-0.5 w-full bg-white/5 rounded-full overflow-hidden mt-2.5"
+      style={{ opacity: fading ? 0 : 1, transition: 'opacity 700ms ease' }}
+    >
+      <div
+        className={`h-full ${barColor}`}
+        style={{
+          width: `${pct}%`,
+          transition: fading ? 'width 300ms ease-out' : 'width 250ms linear',
+          boxShadow: `0 0 8px ${glowColor}`,
+        }}
+      />
+    </div>
+  )
+}
