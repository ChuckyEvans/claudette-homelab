--- /dev/null
+++ b/src/components/ReportsIPClashes.jsx
@@ -0,0 +1,132 @@
+import { useState, useEffect } from 'react'
+import { api, exportToCsv } from '../lib/api.js'
+
+function formatISO(ts) { return new Date(ts).toISOString().slice(0,19).replace('T',' ') }
+
+export default function ReportsIPClashes() {
+  const [data, setData] = useState(null)
+  const [loading, setLoading] = useState(false)
+  const [from, setFrom] = useState('')
+  const [to, setTo] = useState('')
+  const [modal, setModal] = useState(null)
+
+  useEffect(() => { load() }, [])
+  async function load(opts = {}) {
+    setLoading(true)
+    try {
+      const params = {}
+      if (opts.from) params.from = opts.from
+      if (opts.to)   params.to   = opts.to
+      const res = await api.reports.ipClashes(params)
+      setData(res)
+    } catch (e) {
+      setData({ error: e.message })
+    } finally { setLoading(false) }
+  }
+
+  function applyRange() {
+    const f = from ? Date.parse(from) : undefined
+    const t = to ? Date.parse(to) : undefined
+    load({ from: f, to: t })
+  }
+
+  function exportCsv() {
+    if (!data || !data.results) return
+    const rows = []
+    for (const r of data.results) {
+      for (const ip of r.ips) rows.push({ mac: r.mac, ip: ip.ip, last_seen: formatISO(ip.last_seen), count: ip.count, current: ip.current, online: ip.online })
+    }
+    exportToCsv(rows, 'ip-clashes.csv')
+  }
+
+  if (loading) return <div className="p-6 text-slate-300">Loading IP clashes…</div>
+  if (!data) return <div className="p-6 text-slate-300">No data</div>
+  if (data.error) return <div className="p-6 text-red-400">Error: {data.error}</div>
+
+  return (
+    <div className="p-6">
+      <div className="flex items-center justify-between mb-4">
+        <div>
+          <h2 className="text-lg font-semibold text-slate-200">IP Clashes</h2>
+          <p className="text-sm text-slate-400">MAC addresses seen with multiple IPs in the selected window.</p>
+        </div>
+        <div className="flex items-center gap-2">
+          <input type="datetime-local" value={from} onChange={e => setFrom(e.target.value)} className="text-xs bg-[#0b0b14] border border-[#1a1a30] px-2 py-1 rounded" />
+          <input type="datetime-local" value={to}   onChange={e => setTo(e.target.value)}   className="text-xs bg-[#0b0b14] border border-[#1a1a30] px-2 py-1 rounded" />
+          <button onClick={applyRange} className="px-3 py-1.5 text-xs bg-indigo-600/20 border border-indigo-500/30 rounded">Apply</button>
+          <button onClick={exportCsv} className="px-3 py-1.5 text-xs border border-[#1a1a30] rounded">Export CSV</button>
+        </div>
+      </div>
+
+      <div className="space-y-4">
+        {data.results.length === 0 && <div className="text-slate-500">No clashes found.</div>}
+        {data.results.map(r => (
+          <div key={r.mac} className="bg-[#080810] border border-[#1a1a30] rounded-xl p-4">
+            <div className="flex items-start justify-between">
+              <div>
+                <div className="text-sm font-mono text-emerald-300">{r.mac}</div>
+                <div className="text-xs text-slate-400">IPs seen: {r.ip_count}</div>
+              </div>
+              <div className="text-right text-xs text-slate-500">
+                {r.device?.hostname && <div>{r.device.hostname}</div>}
+                <div>{r.device?.ip ?? 'no current record'}</div>
+              </div>
+            </div>
+
+            <div className="mt-3">
+              <table className="w-full text-[13px]">
+                <thead>
+                  <tr className="text-left text-slate-400 text-xs">
+                    <th className="pb-2">IP</th>
+                    <th className="pb-2">Last seen</th>
+                    <th className="pb-2">Count</th>
+                    <th className="pb-2">Current</th>
+                    <th className="pb-2">Online</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {r.ips.map(ip => (
+                    <tr key={ip.ip} className="border-t border-[#1a1a30]">
+                      <td className="pt-2 text-slate-200 font-mono">{ip.ip}</td>
+                      <td className="pt-2 text-slate-400">{new Date(ip.last_seen).toLocaleString()}</td>
+                      <td className="pt-2 text-slate-400">{ip.count}</td>
+                      <td className="pt-2 text-slate-400">{ip.current ? '✓' : ''}</td>
+                      <td className="pt-2 text-slate-400">{ip.online == null ? '—' : ip.online ? '✓' : '✗'}</td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+
+            <div className="mt-3 flex items-center justify-between">
+              <div className="text-xs text-slate-400">Recent events: {r.events?.length ?? 0}</div>
+              <div>
+                <button onClick={() => setModal(r)} className="text-xs px-2 py-1 border border-[#1a1a30] rounded">Show events</button>
+              </div>
+            </div>
+          </div>
+        ))}
+      </div>
+
+      {modal && (
+        <div className="fixed inset-0 z-40 flex items-center justify-center p-4">
+          <div className="absolute inset-0 bg-black/60" onClick={() => setModal(null)} />
+          <div className="relative bg-[#0d0d1a] border border-[#1a1a30] rounded-2xl p-4 max-w-2xl w-full max-h-[80vh] overflow-y-auto">
+            <h3 className="text-sm font-semibold text-slate-200 mb-2">Events for {modal.mac}</h3>
+            <div className="text-xs text-slate-400 space-y-2">
+              {modal.events.map(e => (
+                <div key={e.ts} className="bg-[#080810] p-2 rounded border border-[#1a1a30]">
+                  <div className="text-[11px] text-slate-300 font-mono">{new Date(e.ts).toLocaleString()} — {e.event} {e.ip ? `(${e.ip})` : ''}</div>
+                  <div className="text-[12px] text-slate-400 mt-1">{JSON.stringify(e.payload)}</div>
+                </div>
+              ))}
+            </div>
+            <div className="mt-4 text-right">
+              <button onClick={() => setModal(null)} className="px-3 py-1.5 text-xs border border-[#1a1a30] rounded">Close</button>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  )
+}
