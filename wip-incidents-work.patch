new file mode 100644
index 0000000..2a4c5db
--- /dev/null
+++ b/src/components/NetworkMonitorSettings.jsx
@@ -0,0 +1,80 @@
+import React, { useEffect, useState } from 'react'
+
+export default function NetworkMonitorSettings() {
+  const [cfg, setCfg] = useState({ targets: [], intervalSeconds: 30, timeoutSeconds: 3 })
+  const [loading, setLoading] = useState(true)
+  const [saving, setSaving] = useState(false)
+  const [serverChange, setServerChange] = useState(true)
+  const [lastMonitor, setLastMonitor] = useState(null)
+
+  useEffect(() => {
+    let mounted = true
+    fetch('/api/monitor/config').then(r => r.json()).then(j => { if (mounted) { setCfg(j); setLoading(false) } }).catch(() => setLoading(false))
+
+    // Polling for monitor status (fallback to polling instead of SSE)
+    let poll = null
+    const doPoll = async () => {
+      try {
+        const resp = await fetch('/api/monitor/probe', { method: 'POST' })
+        const j = await resp.json()
+        if (mounted) setLastMonitor(j)
+      } catch { /* ignore */ }
+    }
+    doPoll()
+    poll = setInterval(doPoll, 10000)
+    return () => { mounted = false; if (poll) clearInterval(poll) }
+  }, [])
+
+  function updateTarget(i, val) {
+    const t = [...cfg.targets]; t[i] = val; setCfg({ ...cfg, targets: t })
+  }
+
+  function addTarget() { setCfg({ ...cfg, targets: [...cfg.targets, ''] }) }
+  function removeTarget(i) { const t = cfg.targets.filter((_, idx) => idx !== i); setCfg({ ...cfg, targets: t }) }
+
+  async function save() {
+    setSaving(true)
+    try {
+      if (serverChange) {
+        await fetch('/api/monitor/config', { method: 'POST', headers: { 'Content-Type':'application/json' }, body: JSON.stringify(cfg) })
+      } else {
+        // user-only: persist to cookie/localStorage
+        localStorage.setItem('monitor.config', JSON.stringify(cfg))
+      }
+      alert('Saved')
+    } catch (e) { alert('Save failed: ' + e.message) }
+    setSaving(false)
+  }
+
+  if (loading) return <div>Loading...</div>
+
+  return (
+    <div>
+      <h3>Network Monitor</h3>
+      <div className="mb-2 text-sm text-slate-500">Change type: <strong>{serverChange ? 'Server (persisted)' : 'User (local only)'}</strong></div>
+      <label>Save to server?</label>
+      <input type="checkbox" checked={serverChange} onChange={e => setServerChange(e.target.checked)} />
+
+      <label>Probe interval (seconds)</label>
+      <input type="number" value={cfg.intervalSeconds} onChange={e => setCfg({ ...cfg, intervalSeconds: parseInt(e.target.value||0,10) })} />
+      <label>Timeout (seconds)</label>
+      <input type="number" value={cfg.timeoutSeconds} onChange={e => setCfg({ ...cfg, timeoutSeconds: parseInt(e.target.value||0,10) })} />
+      <h4>Targets</h4>
+      {cfg.targets.map((t, i) => (
+        <div key={i} className="flex items-center gap-2">
+          <input value={t} onChange={e => updateTarget(i, e.target.value)} />
+          <button disabled={saving} onClick={() => removeTarget(i)}>Remove</button>
+        </div>
+      ))}
+      <button disabled={saving} onClick={addTarget}>Add target</button>
+      <div className="mt-3">
+        <button disabled={saving} onClick={save} className={saving? 'opacity-50 cursor-not-allowed' : ''}>{saving? 'Saving…' : 'Save'}</button>
+      </div>
+
+      <div className="mt-4">
+        <h4>Last live monitor</h4>
+        <pre style={{maxHeight:200,overflow:'auto'}}>{lastMonitor ? JSON.stringify(lastMonitor, null, 2) : 'No recent monitor events'}</pre>
+      </div>
+    </div>
+  )
+}
