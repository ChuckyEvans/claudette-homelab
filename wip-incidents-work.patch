+
+const router = express.Router()
+
+// Lightweight incidents summary: include ip-clashes and placeholders for detectors
+router.get('/', async (req, res) => {
+  try {
+    // IP clashes: reuse existing query from reports route if present
+    const clashes = await (async () => {
+      try {
+        const rows = req.app.locals.db.prepare('SELECT mac, ip, last_seen, count, current FROM ip_history').all()
+        // naive grouping by mac
+        const map = new Map()
+        for (const r of rows) {
+          if (!map.has(r.mac)) map.set(r.mac, [])
+          map.get(r.mac).push(r)
+        }
+        const results = []
+        for (const [mac, ips] of map.entries()) {
+          if (new Set(ips.map(i => i.ip)).size > 1) {
+            results.push({ mac, ips })
+          }
+        }
+        return { results }
+      } catch (e) { return { error: e.message } }
+    })()
