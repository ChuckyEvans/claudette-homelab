+// POST /api/network/message/:ip — send a NetBIOS popup message to a LAN device
+// Uses smbclient -M, the Linux equivalent of the Windows 'net send' / 'msg' command.
+// The recipient Windows machine must have the Messenger service enabled (disabled by
+// default in Vista+, but many homelab and domain-joined machines re-enable it).
+router.post('/message/:ip', (req, res) => {
+  const { ip } = req.params
+  const { message } = req.body ?? {}
+
+  if (!ip || !/^(\d{1,3}\.){3}\d{1,3}$/.test(ip)) {
+    return res.status(400).json({ error: 'Invalid IP address' })
+  }
+  if (!isPrivateIP(ip)) {
+    return res.status(400).json({ error: `'${ip}' is not a private LAN address` })
+  }
+  if (typeof message !== 'string' || !message.trim()) {
+    return res.status(400).json({ error: 'Message is required' })
+  }
+
+  const text = message.trim().slice(0, 500)
+
+  // Spawn smbclient without a shell to prevent any injection.
+  // smbclient -M reads the message body from stdin.
+  const proc = spawn('smbclient', ['-M', ip, '-N'], { stdio: ['pipe', 'pipe', 'pipe'] })
+  let out = ''
+  proc.stdout.on('data', d => { out += d })
+  proc.stderr.on('data', d => { out += d })
+  proc.stdin.write(text + '\n')
+  proc.stdin.end()
+
+  const timer = setTimeout(() => { try { proc.kill() } catch { /* ignore */ } }, 10000)
+
+  proc.on('close', code => {
+    clearTimeout(timer)
+    if (code !== 0 && !out.toLowerCase().includes('connected')) {
+      return res.status(500).json({
+        error: out.trim() || 'smbclient failed — the target may not have the Messenger service enabled',
+        output: out.trim(),
+      })
+    }
+    audit('device.message_sent', { ip, length: text.length })
+    res.json({ sent: true, output: out.trim() })
+  })
+
+  proc.on('error', err => {
+    clearTimeout(timer)
+    res.status(500).json({ error: `smbclient not available: ${err.message}`, output: '' })
+  })
+})
+
 export default router
