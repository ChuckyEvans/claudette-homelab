diff --git a/server/monitor.js b/server/monitor.js
new file mode 100644
index 0000000..fc48af6
--- /dev/null
+++ b/server/monitor.js
@@ -0,0 +1,101 @@
+import { exec } from 'child_process'
+import { promisify } from 'util'
+import fs from 'fs'
+import path from 'path'
+
+const execP = promisify(exec)
+
+const DEFAULT_TARGETS = [
+  '1.1.1.1',
+  '8.8.8.8',
+  '9.9.9.9',
+  'cloudflare-dns.com',
+  'google.com',
+  'microsoft.com',
+  'github.com',
+  'amazon.com'
+]
+
+function getStateFile() {
+  return path.join(process.cwd(), 'data', 'monitor-state.json')
+}
+
+export function loadMonitorConfig() {
+  try {
+    const file = getStateFile()
+    if (fs.existsSync(file)) {
+      return JSON.parse(fs.readFileSync(file, 'utf8'))
+    }
+  } catch { /* ignore */ }
+  return { targets: DEFAULT_TARGETS, intervalSeconds: 30, timeoutSeconds: 3 }
+}
+
+export function saveMonitorConfig(cfg) {
+  const file = getStateFile()
+  try {
+    fs.mkdirSync(path.dirname(file), { recursive: true })
+    fs.writeFileSync(file, JSON.stringify(cfg, null, 2))
+    return true
+  } catch { return false }
+}
+
+export async function probeHost(host, timeoutSeconds = 3) {
+  // Use system ping where available. -c/ -W for linux/mac, -n/-w for windows
+  const isWin = process.platform === 'win32'
+  const countFlag = isWin ? '-n' : '-c'
+  const waitFlag = isWin ? '-w' : '-W'
+  const cmd = `ping ${countFlag} 1 ${waitFlag} ${timeoutSeconds} ${host}`
+  try {
+    const { stdout } = await execP(cmd, { timeout: (timeoutSeconds + 1) * 1000 })
+    const ok = /ttl=/i.test(stdout)
+    return { host, ok, raw: stdout, ts: Date.now() }
+  } catch (e) {
+    return { host, ok: false, error: e.message, ts: Date.now() }
+  }
+}
+
+export async function probeAll(targets, timeoutSeconds) {
+  const results = []
+  for (const t of targets) {
+    // sequential on purpose to avoid flooding
+     
+    results.push(await probeHost(t, timeoutSeconds))
+  }
+  return results
+}
+
+let _running = false
+let _lastResults = { ts: 0, results: [] }
+
+export function getLastResults() {
+  return _lastResults
+}
+
+export async function runProbeAndCache(broadcast) {
+  if (_running) return _lastResults
+  _running = true
+  try {
+    const cfg = loadMonitorConfig()
+    const results = await probeAll(cfg.targets || [], cfg.timeoutSeconds || 3)
+    _lastResults = { ts: Date.now(), results }
+    if (typeof broadcast === 'function') {
+      try { broadcast('monitor', _lastResults) } catch { /* ignore */ }
+    }
+    return _lastResults
+  } finally { _running = false }
+}
+
+let _intervalHandle = null
+
+export function startScheduler(broadcast) {
+  const cfg = loadMonitorConfig()
+  const interval = (cfg.intervalSeconds || 30) * 1000
+  if (_intervalHandle) clearInterval(_intervalHandle)
+  // run immediately once
+  runProbeAndCache(broadcast).catch(() => {})
+  _intervalHandle = setInterval(() => { runProbeAndCache(broadcast).catch(() => {}) }, interval)
+}
+
+export function stopScheduler() {
+  if (_intervalHandle) { clearInterval(_intervalHandle); _intervalHandle = null }
+}
