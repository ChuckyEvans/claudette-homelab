+import express from 'express'
+import { loadMonitorConfig, saveMonitorConfig, probeAll, runProbeAndCache, getLastResults } from '../monitor.js'
+
+const router = express.Router()
+
+router.get('/config', (_req, res) => {
+  res.json(loadMonitorConfig())
+})
+
+router.post('/config', (req, res) => {
+  const cfg = req.body
+  if (!cfg || !Array.isArray(cfg.targets)) return res.status(400).json({ error: 'invalid' })
+  const ok = saveMonitorConfig(cfg)
+  if (!ok) return res.status(500).json({ error: 'failed to save' })
+  res.json({ ok: true })
+})
+
+router.post('/probe', async (req, res) => {
+  try {
+    // Prefer guarded scheduler run to prevent duplicate probing
+    const run = await runProbeAndCache()
+    // If caller provided overrides, still run a one-off probe (but don't duplicate if already running)
+    const overrides = req.body || {}
+    if ((overrides.targets || overrides.timeoutSeconds) && !(run && run.ts && Date.now() - run.ts < 1000)) {
+      const cfg = loadMonitorConfig()
+      const timeout = overrides.timeoutSeconds ?? cfg.timeoutSeconds
+      const targets = overrides.targets ?? cfg.targets
+      const results = await probeAll(targets, timeout)
+      return res.json({ ts: Date.now(), results })
+    }
+    // Return cached results
+    return res.json(getLastResults())
+  } catch (e) {
+    return res.status(500).json({ error: e.message })
+  }
+})
+
+export default router
