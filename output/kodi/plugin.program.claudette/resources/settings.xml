<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
  <setting label="Connection" type="lsep" />
  <setting id="server_url" type="text"   label="Claudette Server URL"       default="http://192.168.8.10:7654" />
  <setting id="username"   type="text"   label="Username"                   default="" />
  <setting id="password"   type="text"   label="Password"                   default="" option="hidden" />
  <setting id="timeout"    type="slider" label="Request timeout (seconds)"  default="10" range="3,1,30" option="int" />

  <setting label="Devices" type="lsep" />
  <setting id="show_offline_devices"  type="bool"   label="Show offline devices"         default="true" />
  <setting id="device_page_size"      type="slider" label="Devices per page"              default="20"   range="10,5,50"  option="int" />

  <setting label="Threats" type="lsep" />
  <setting id="threat_min_severity"   type="enum"   label="Minimum threat severity"       default="1"    values="Low|Medium|High|Critical" />

  <setting label="Speed Tests" type="lsep" />
  <setting id="speedtest_limit"       type="slider" label="Speed test results to show"    default="10"   range="5,5,30"   option="int" />
  <setting id="isp_plan_dl"          type="number" label="ISP plan download (Mbps, 0=off)" default="0" />
  <setting id="isp_plan_ul"          type="number" label="ISP plan upload (Mbps, 0=off)"   default="0" />

  <setting label="Audit Log" type="lsep" />
  <setting id="audit_limit"           type="slider" label="Audit events per page"         default="50"   range="10,10,100" option="int" />

  <setting label="DDNS" type="lsep" />
  <setting id="ddns_history_limit"    type="slider" label="DDNS history entries to show"  default="15"   range="5,5,30"   option="int" />
</settings>
