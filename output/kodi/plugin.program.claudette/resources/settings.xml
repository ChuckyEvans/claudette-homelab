<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
  <setting label="Server" type="lsep" />
  <setting id="server_url" type="text"   label="Claudette Server URL"        default="http://192.168.8.10:7654" />
  <setting id="username"   type="text"   label="Username"                    default="" />
  <setting id="password"   type="text"   label="Password"                    default="" />
  <setting id="timeout"    type="slider" label="Request Timeout (seconds)"   default="10" range="3,1,30" option="int" />

  <setting label="Display" type="lsep" />
  <setting id="show_offline_devices"  type="bool"   label="Show offline devices"     default="true" />
  <setting id="threat_min_severity"   type="enum"   label="Minimum threat severity"  default="1"    values="Low|Medium|High|Critical" />
  <setting id="audit_limit"           type="slider" label="Audit events to show"     default="50"   range="10,10,200" option="int" />
</settings>
